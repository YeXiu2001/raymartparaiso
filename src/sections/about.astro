---
import { PERSON_NAME, PROFILE_HEADSHOT_PATH } from "../data/site";

const stack = [
  { name: "Laravel", src: "https://cdn.simpleicons.org/laravel/FF2D20?viewbox=auto" },
  { name: "Livewire", src: "https://cdn.simpleicons.org/livewire/FB70A9?viewbox=auto" },
  { name: "MySQL", src: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mysql/mysql-original.svg" },
  { name: "JavaScript", src: "https://cdn.simpleicons.org/javascript/F7DF1E?viewbox=auto" },
  { name: "AlpineJS", src: "https://cdn.simpleicons.org/alpinedotjs/8BC0D0?viewbox=auto" },
  { name: "jQuery", src: "https://cdn.simpleicons.org/jquery/0769AD?viewbox=auto" },
  { name: "Astro", src: "https://cdn.simpleicons.org/astro/FFFFFF?viewbox=auto" },
  { name: "TailwindCSS", src: "https://cdn.simpleicons.org/tailwindcss/06B6D4?viewbox=auto" },
  { name: "DaisyUI", src: "https://cdn.simpleicons.org/daisyui" },
  { name: "Bootstrap 5", src: "https://cdn.simpleicons.org/bootstrap" },
  { name: "GitHub", src: "https://cdn.simpleicons.org/github/FFFFFF?viewbox=auto" },
  { name: "CloudPanel", src: "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/cloudpanel.svg" },
  { name: "DigitalOcean", src: "https://cdn.simpleicons.org/digitalocean/0080FF?viewbox=auto" },
];

const highlights = [
  {
    icon: "fa-solid fa-briefcase",
    label: "Current Role",
    value: "Full Stack Developer",
    detail: "Perzeus Corporation",
  },
  {
    icon: "fa-solid fa-layer-group",
    label: "Core Stack",
    value: "Laravel + Livewire",
    detail: "MySQL, AlpineJS, TailwindCSS",
  },
];
---

<section id="about" class="content-section text-base-content">

  <div class="content-section-header max-w-4xl">
    <h2 class="card-title text-3xl font-['Bruno_Ace_SC'] leading-tight text-info sm:text-4xl lg:text-5xl">
      About Me
    </h2>
    <p class="max-w-3xl text-sm leading-7 text-base-content/70 sm:text-base sm:leading-8">
      A quick look at my background, current role, and the tools I use to build and ship web products.
    </p>
  </div>

  <div class="grid gap-10 lg:grid-cols-[auto_1fr] lg:items-start lg:gap-12 xl:grid-cols-[auto_1fr_26rem]">

    <!-- Left: Stacked Cards -->
    <div class="flex justify-center lg:justify-start lg:pt-2">
      <div class="stack stack-bottom">
        <!-- Front card with image (first = frontmost in daisyUI stack) -->
        <div class="relative w-52 h-72 rounded-2xl overflow-hidden border border-white/15 opacity-80">
          <img
            src={PROFILE_HEADSHOT_PATH}
            alt={PERSON_NAME}
            class="absolute inset-0 h-full w-full object-cover object-top"
            loading="lazy"
          />
          <!-- gradient only at the bottom for caption readability -->
          <div class="absolute bottom-0 inset-x-0 h-28 bg-linear-to-t from-black/80 to-transparent"></div>
          <div class="absolute bottom-0 inset-x-0 p-4 text-center">
            <p class="text-[0.58rem] font-semibold uppercase tracking-[0.22em] text-white/55 mb-1">
              The Man Behind The Scenes
            </p>
            <p class="text-sm font-bold text-white leading-tight">
              Raymart Paraiso
            </p>
          </div>
        </div>
        <!-- Middle card -->
        <div class="card w-52 h-72 border border-white/10 bg-base-200/40"></div>
        <!-- Back card -->
        <div class="card w-52 h-72 border border-white/8 bg-base-300/30"></div>
      </div>
    </div>

    <!-- Middle: Bio + Highlights -->
    <div class="flex flex-col justify-center gap-6">
      <div class="space-y-5">
        <p class="text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-primary/80">
          Developer Profile
        </p>
        <p class="text-sm leading-7 text-base-content/85 sm:text-base sm:leading-8 text-justify">
          I'm Allan Raymart Paraiso, a full-stack developer from Pagadian City primarily using Laravel and Livewire with 2 years of professional experience.
        </p>
        <p class="text-sm leading-7 text-base-content/70 sm:text-base sm:leading-8 text-justify">
          Since June 2025, I've been working as an end-to-end product developer at Perzeus Corporation, building web applications from product conception and system design to deployment, server management, and ongoing product improvement.
        </p>
      </div>

      <hr class="border-white/10" />

      <div class="space-y-4">
        {highlights.map((item) => (
          <div class="flex items-start gap-4">
            <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-info">
              <i class={`${item.icon} text-sm`}></i>
            </div>
            <div class="min-w-0">
              <p class="text-[0.63rem] font-semibold uppercase tracking-[0.24em] text-base-content/45">
                {item.label}
              </p>
              <p class="mt-1 text-sm font-semibold text-white sm:text-base">
                {item.value}
                <span class="font-normal text-base-content/55"> · {item.detail}</span>
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Right: Tech Stack in mockup-window -->
    <div class="mockup-window bg-base-300/30 border border-white/10 w-full lg:col-span-2 xl:col-span-1">
      <div class="px-4 pb-1 pt-1 border-t border-white/10">
        <div class="flex items-center justify-between mb-3 pt-2">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-base-content/55">
            Tools I Build With
          </p>
        </div>
        <div class="grid grid-cols-3 gap-2 pb-3 max-h-[360px] overflow-y-auto">
          {stack.map((item) => (
            <div class="flex flex-col items-center gap-2 rounded-xl p-3 hover:bg-base-300/50 transition-colors duration-200 cursor-default">
              <img
                src={item.src}
                alt={`${item.name} logo`}
                loading="lazy"
                class="h-10 w-10 object-contain"
              />
              <span class="text-xs font-medium text-base-content/60 text-center leading-tight">
                {item.name}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>
