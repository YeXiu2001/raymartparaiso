---
const distinctions = [
  "Gawad Chancellor's Award for Academic Excellence",
  "DOST Academic Excellence Award",
];
---

<section id="education" class="content-section text-slate-100">
  <div class="content-section-header max-w-3xl">
    <h2 class="card-title text-3xl font-['Bruno_Ace_SC'] text-info sm:text-4xl lg:text-5xl">Academics</h2>
  </div>

  <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
    <article class="card card-bordered border-white/10 bg-base-100/35 shadow-xl backdrop-blur-sm">
      <div class="card-body gap-6 p-6 sm:p-8">
        <div class="space-y-2">
          <p class="text-xs uppercase tracking-[0.26em] text-base-content/60 sm:text-sm sm:tracking-[0.3em]">MSU - Iligan Institute of Technology</p>
          <h3 class="text-xl font-semibold leading-tight text-white sm:text-2xl lg:text-3xl">BS Information Technology</h3>
          <p class="text-sm text-base-content/75 sm:text-base lg:text-lg">Major in Database Systems</p>
        </div>

        <div class="flex flex-col gap-4 border-t border-white/10 pt-6 sm:flex-row sm:items-start sm:gap-0 sm:pt-0">
          <div class="space-y-2 sm:min-w-[8rem] sm:px-5 sm:py-6 sm:first:pl-0 sm:[&:not(:last-child)]:border-r sm:[&:not(:last-child)]:border-white/10">
            <div class="text-xs uppercase tracking-[0.24em] text-base-content/60">Graduated</div>
            <div class="text-2xl font-semibold text-white sm:text-3xl">2024</div>
          </div>

          <div class="space-y-2 sm:min-w-[14rem] sm:flex-1 sm:px-5 sm:py-6 sm:[&:not(:last-child)]:border-r sm:[&:not(:last-child)]:border-white/10">
            <div class="text-xs uppercase tracking-[0.24em] text-base-content/60">Latin Honor</div>
            <div class="text-xl font-semibold text-white sm:whitespace-nowrap sm:text-2xl lg:text-3xl">Magna Cum Laude</div>
          </div>

          <div class="space-y-2 sm:min-w-[7rem] sm:px-5 sm:py-6 sm:pr-0">
            <div class="text-xs uppercase tracking-[0.24em] text-base-content/60">GWA</div>
            <div class="flex items-end gap-2">
              <span class="text-3xl font-semibold leading-none text-white sm:text-4xl lg:text-4xl">1.43</span>
            </div>
          </div>
        </div>
      </div>
    </article>

    <aside class="card card-bordered border-white/10 bg-base-100/35 shadow-xl backdrop-blur-sm">
      <div class="card-body p-6 sm:p-8">
        <div class="space-y-2">
          <p class="text-xs uppercase tracking-[0.26em] text-base-content/60 sm:text-sm sm:tracking-[0.3em]">Other Key Distinctions</p>
          <h3 class="text-xl font-semibold text-white sm:text-2xl">Academic Awards</h3>
        </div>

        <div class="mt-2 divide-y divide-white/10">
          {distinctions.map((distinction) => (
            <div class="flex items-start gap-4 py-4 first:pt-0 last:pb-0 sm:py-5">
              <div class="mt-1 flex h-10 w-10 flex-none items-center justify-center rounded-full border border-white/10 bg-base-300/60 text-info">
                <i class="fa-solid fa-award text-sm"></i>
              </div>
              <p class="text-sm leading-6 text-base-content/80 sm:text-base sm:leading-7">{distinction}</p>
            </div>
          ))}
        </div>
      </div>
    </aside>
  </div>
</section>
