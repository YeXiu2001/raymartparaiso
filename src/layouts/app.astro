---
import "../assets/app.css";
import Header from "../components/header.astro";
import { SITE_NAME, SITE_URL } from "../data/site";

type StructuredData = Record<string, unknown>;

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImagePath?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  robots?: string;
  structuredData?: StructuredData | StructuredData[];
}

const {
  title = SITE_NAME,
  description = "",
  canonicalPath = "/",
  ogImagePath,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  robots = "index,follow",
  structuredData = [],
} = Astro.props as Props;

const site = Astro.site ?? new URL(SITE_URL);
const canonicalUrl = new URL(canonicalPath, site).toString();
const ogImageUrl = ogImagePath ? new URL(ogImagePath, site).toString() : undefined;
const schemaItems = Array.isArray(structuredData) ? structuredData : [structuredData];
---
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Allan Raymart Paraiso" />
    <meta name="robots" content={robots} />
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href={new URL("/sitemap-index.xml", site).toString()} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-192x192.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bruno+Ace+SC&family=Chiron+GoRound+TC:wght@200..900&display=swap" rel="stylesheet">
    <title>{title || "Raymart Paraiso"}</title>
    <meta name="theme-color" content="#0f172a" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {ogImageUrl && ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    {schemaItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body>
    <div class="min-h-dvh flex flex-col">
      <Header />
      <main class="flex-1">
        <slot />
      </main>
    </div>
  </body>
</html>
