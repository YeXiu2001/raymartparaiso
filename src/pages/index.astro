---
import Layout from "../layouts/app.astro";
import Hero from "../sections/hero.astro";
---
<Layout title="Home">
  <section id="home" class="hero min-h-[calc(100dvh-4rem)]">
    <Hero />
  </section>

  <section id="about" class="container mx-auto px-4 py-16 text-slate-100">
    <h2 class="mb-4 text-3xl font-['Bruno_Ace_SC'] text-info">About</h2>
    <p class="max-w-3xl text-lg">
      I focus on building reliable software with practical UX and clear business value.
    </p>
  </section>

  <section id="work-experience" class="container mx-auto px-4 py-16 text-slate-100">
    <h2 class="mb-4 text-3xl font-['Bruno_Ace_SC'] text-info">Work Experience</h2>
    <p class="max-w-3xl text-lg">
      Experience highlights go here. You can later extract this section into `src/pages/work-experience.astro`.
    </p>
  </section>

  <section id="projects" class="container mx-auto px-4 py-16 text-slate-100">
    <h2 class="mb-4 text-3xl font-['Bruno_Ace_SC'] text-info">Projects</h2>
    <p class="max-w-3xl text-lg">
      Featured projects and case studies go here. This section can become its own page later.
    </p>
  </section>

  <section id="education" class="container mx-auto px-4 py-16 text-slate-100">
    <h2 class="mb-4 text-3xl font-['Bruno_Ace_SC'] text-info">Education</h2>
    <p class="max-w-3xl text-lg">
      Your education details go here, ready to move to a dedicated route when needed.
    </p>
  </section>
</Layout>
